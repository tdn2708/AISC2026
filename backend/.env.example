# Cổng máy chủ API
PORT=5000

# Chuỗi kết nối MongoDB. KHÔNG commit tệp .env thật lên repo.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/?retryWrites=true&w=majority

# Khóa mô hình ngôn ngữ. Hệ thống vẫn chạy khi thiếu các khóa này:
# phân loại lùi về lớp luật từ khóa, còn toàn bộ chỉ số và cảnh báo
# được tính bằng thống kê nên không phụ thuộc vào chúng.
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Dịch vụ ViSoBERT (nlp_service/). Không chạy thì hệ thống lùi về lớp luật.
# VISOBERT_URL=off để tắt hẳn.
VISOBERT_URL=http://127.0.0.1:8001
VISOBERT_TIMEOUT_MS=30000
# masked = chỉ che PII, giữ teencode/emoji (mặc định); normalized = qua toàn bộ normalizer
VISOBERT_INPUT_MODE=masked
# 1 = dùng vector nhúng (T2) và xác suất rác (T1) trong Trust Layer. Lần đầu phải nhúng cả kho dữ liệu.
VISOBERT_TRUST_SIGNALS=0
